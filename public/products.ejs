<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <!-- Icon Dollar -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Flatpickr Date Picker -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <!-- SheetJS for Client-side Preview -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <style>
        .hpp-input {
            width: 100%;
            border: 2px solid #ff9800;
            border-radius: 4px;
            padding: 4px 8px;
            font-size: 14px;
        }
        .hpp-display {
            cursor: pointer;
            padding: 4px;
            border-radius: 4px;
            transition: background-color 0.2s;
        }
        .hpp-display:hover {
            background-color: #fff3e0;
        }
        .text-input {
            width: 100%;
            border: 2px solid #ff9800;
            border-radius: 4px;
            padding: 4px 8px;
            font-size: 14px;
        }
        .text-display {
            cursor: pointer;
            padding: 4px;
            border-radius: 4px;
            transition: background-color 0.2s;
        }
        .text-display:hover {
            background-color: #fff3e0;
        }
    </style>
</head>
<body class="bg-gray-50 flex min-h-screen">
    <%- include('partials/sidebar') %>

    <!-- Main Content -->
    <main class="flex-1 lg:ml-64 xl:ml-72 flex flex-col">
        <!-- Header -->
        <header class="bg-white border-b border-gray-200 sticky top-0 z-30 px-6 py-4 shadow-sm">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div class="flex items-center space-x-3">
                    <div class="bg-orange-100 p-2 rounded-lg">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                    </div>
                    <div>
                        <h1 class="text-xl font-bold text-gray-900 leading-tight"><%= pageTitle %></h1>
                        <p class="text-xs text-gray-500 mt-0.5">Daftar produk yang sudah terpetakan dengan ID Product</p>
                    </div>
                </div>
                <div class="flex items-center space-x-3">
                    <button onclick="openAddModal()" class="inline-flex items-center gap-2 rounded-md bg-orange-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-orange-700 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                        Tambah Produk
                    </button>
                    <a href="/" class="inline-flex items-center gap-2 rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                        Dashboard
                    </a>
                </div>
            </div>
        </header>
        <div class="p-6 flex-1">
            <!-- Success/Error Messages -->
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="mb-4 bg-green-50 border border-green-200 rounded-md p-4">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <div class="ml-3">
                            <p class="text-sm font-medium text-green-800"><%= success %></p>
                        </div>
                    </div>
                </div>
            <% } %>
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="mb-4 bg-red-50 border border-red-200 rounded-md p-4">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <div class="ml-3">
                            <p class="text-sm font-medium text-red-800"><%= error %></p>
                        </div>
                    </div>
                </div>
            <% } %>

            <!-- Main Content Card -->
            <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
                <div class="px-6 py-5 border-b border-gray-100 flex items-center justify-between bg-slate-50/50">
                    <div>
                        <h2 class="text-sm font-bold text-gray-900">Produk Terpetakan</h2>
                        <p class="text-[11px] text-gray-500 mt-0.5">Ditemukan <%= products.length %> produk yang sudah terpetakan dengan ID Product</p>
                    </div>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-50/50 border-b border-gray-200">
                                <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">ID Product</th>
                                <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Variant Name</th>
                                <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Product Name</th>
                                <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">HPP</th>
                                <th class="px-6 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wider">Aksi</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200" id="productsTableBody">
                            <% products.forEach((product, index) => { %>
                                <tr class="hover:bg-gray-100" data-product-id="<%= product['ID Product'].replace(/"/g, '&quot;') %>">
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 font-mono"><%= product['ID Product'] %></td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                        <div class="text-display" data-field="variantName" onclick="editTextField(this)">
                                            <span class="text-value"><%= product['Variant Name'] %></span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                        <div class="text-display" data-field="productName" onclick="editTextField(this)">
                                            <span class="text-value"><%= product['Product Name'] %></span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                        <div class="hpp-display" onclick="editHPP(this)">
                                            Rp <span class="hpp-value"><%= product['HPP'].toLocaleString('id-ID') %></span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                        <div class="flex items-center space-x-2">
                                            <button onclick="deleteProduct('<%= product['ID Product'].replace(/'/g, "\\'") %>', '<%= product['Product Name'].replace(/'/g, "\\'") %>')" class="text-red-600 hover:text-red-900 p-1">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6"/>
                                                </svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Add Product Modal -->
        <div id="addModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full hidden z-50">
            <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
                <div class="mt-3">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-lg font-medium text-gray-900">Tambah Produk Baru</h3>
                        <button onclick="closeAddModal()" class="text-gray-400 hover:text-gray-600">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M18 6L6 18M6 6l12 12"/>
                            </svg>
                        </button>
                    </div>
                    <form id="addProductForm" action="/products/create" method="POST" class="space-y-4">
                        <div>
                            <label for="addVariantName" class="block text-sm font-medium text-gray-700">Variant Name</label>
                            <input type="text" id="addVariantName" name="variantName" required class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-orange-500 focus:border-orange-500">
                        </div>
                        <div>
                            <label for="addProductName" class="block text-sm font-medium text-gray-700">Product Name</label>
                            <input type="text" id="addProductName" name="productName" required class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-orange-500 focus:border-orange-500">
                        </div>
                        <div>
                            <label for="addHpp" class="block text-sm font-medium text-gray-700">HPP</label>
                            <input type="number" id="addHpp" name="hpp" required class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm py-2 px-3 focus:outline-none focus:ring-orange-500 focus:border-orange-500">
                        </div>
                        <div class="flex justify-end space-x-3 pt-4">
                            <button type="button" onclick="closeAddModal()" class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50">Batal</button>
                            <button type="submit" class="px-4 py-2 bg-orange-600 border border-transparent rounded-md text-sm font-medium text-white hover:bg-orange-700">Tambah</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    <script>
        function openAddModal() {
            document.getElementById('addModal').classList.remove('hidden');
        }
        function closeAddModal() {
            document.getElementById('addModal').classList.add('hidden');
        }

        // Generic function for editing text fields (Variant, Product Name)
        function editTextField(element) {
            if (element.querySelector('input')) return;

            const valueSpan = element.querySelector('.text-value');
            const currentValue = valueSpan.innerText;
            const field = element.dataset.field;
            const row = element.closest('tr');
            const productId = row.dataset.productId;

            const input = document.createElement('input');
            input.type = 'text';
            input.value = currentValue;
            input.className = 'text-input';
            
            element.innerHTML = '';
            element.appendChild(input);
            input.focus();

            const save = async () => {
                const newValue = input.value.trim();
                if (!newValue || newValue === currentValue) {
                    element.innerHTML = `<span class="text-value">${currentValue}</span>`;
                    return;
                }

                try {
                    const response = await fetch('/update-product-field', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId, field, newValue })
                    });

                    const result = await response.json();
                    if (result.success) {
                        element.innerHTML = `<span class="text-value">${newValue}</span>`;
                    } else {
                        alert('Gagal: ' + result.message);
                        element.innerHTML = `<span class="text-value">${currentValue}</span>`;
                    }
                } catch (error) {
                    element.innerHTML = `<span class="text-value">${currentValue}</span>`;
                }
            };

            input.onblur = save;
            input.onkeydown = (e) => {
                if (e.key === 'Enter') save();
                if (e.key === 'Escape') element.innerHTML = `<span class="text-value">${currentValue}</span>`;
            };
        }

        // Function for editing HPP
        function editHPP(element) {
            if (element.querySelector('input')) return;

            const valueSpan = element.querySelector('.hpp-value');
            const currentValue = valueSpan.innerText.replace(/\./g, '');
            const row = element.closest('tr');
            const productId = row.dataset.productId;

            const input = document.createElement('input');
            input.type = 'number';
            input.value = currentValue;
            input.className = 'hpp-input';
            
            element.innerHTML = '';
            element.appendChild(input);
            input.focus();

            const save = async () => {
                const newValue = input.value;
                if (!newValue || newValue === currentValue) {
                    element.innerHTML = `Rp <span class="hpp-value">${parseInt(currentValue).toLocaleString('id-ID')}</span>`;
                    return;
                }

                try {
                    const response = await fetch('/update-product-field', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId, field: 'hpp', newValue })
                    });

                    const result = await response.json();
                    if (result.success) {
                        element.innerHTML = `Rp <span class="hpp-value">${parseInt(newValue).toLocaleString('id-ID')}</span>`;
                    } else {
                        alert('Gagal: ' + result.message);
                        element.innerHTML = `Rp <span class="hpp-value">${parseInt(currentValue).toLocaleString('id-ID')}</span>`;
                    }
                } catch (error) {
                    element.innerHTML = `Rp <span class="hpp-value">${parseInt(currentValue).toLocaleString('id-ID')}</span>`;
                }
            };

            input.onblur = save;
            input.onkeydown = (e) => {
                if (e.key === 'Enter') save();
                if (e.key === 'Escape') element.innerHTML = `Rp <span class="hpp-value">${parseInt(currentValue).toLocaleString('id-ID')}</span>`;
            };
        }

        async function deleteProduct(productId, productName) {
            if (confirm(`Hapus produk "${productName}"?`)) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/products/delete';
                
                const input = document.createElement('input');
                input.type = 'hidden';
                input.name = 'productId';
                input.value = productId;
                
                form.appendChild(input);
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
</body>
</html>
