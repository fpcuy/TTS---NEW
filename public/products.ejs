<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <!-- Icon Dollar -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Flatpickr Date Picker -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <!-- SheetJS for Client-side Preview -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
</head>
<body class="bg-gray-50 flex min-h-screen">
    <%- include('partials/sidebar') %>

    <!-- Main Content -->
    <main class="flex-1 lg:ml-64 xl:ml-72 flex flex-col">
        <!-- Header -->
        <header class="bg-white border-b border-gray-200 sticky top-0 z-30 px-6 py-4">
            <div class="flex items-center space-x-3">
                <div class="bg-primary-50 p-2 rounded-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="2">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                        <path d="M3 6h18"/>
                        <path d="M16 10a4 4 0 0 1-8 0"/>
                    </svg>
                </div>
                <div>
                    <h1 class="text-xl font-bold text-gray-900 leading-tight"><%= pageTitle %></h1>
                    <p class="text-xs text-gray-500">Manajemen data produk</p>
                </div>
            </div>
        </header>

        <!-- Main Table Container -->
        <div class="p-6 flex-1">
            <!-- Alert Produk Baru Ditemukan -->
            <% if (locals.previewData && previewData.length > 0) { %>
            <div class="mb-6 bg-amber-50 border border-amber-200 rounded-xl p-4 flex items-center justify-between shadow-sm animate-pulse">
                <div class="flex items-center space-x-3">
                    <div class="bg-amber-100 p-2 rounded-lg">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    </div>
                    <p class="text-sm font-medium text-amber-800">Ditemukan <strong><%= previewData.length %></strong> produk baru dari data pengiriman yang belum terdaftar.</p>
                </div>
                <button onclick="document.getElementById('syncModal').classList.remove('hidden')" class="px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold rounded-lg transition-colors">Tampilkan Produk</button>
            </div>
            <% } %>

            <div class="bg-white shadow-sm border border-gray-200 rounded-xl overflow-hidden">
                <div class="overflow-x-auto scrollbar-thin scrollbar-thumb-gray-300">
                    <table class="w-full text-left border-collapse min-w-[800px]">
                        <thead class="bg-gray-50 border-b-2 border-gray-100">
                            <tr>
                                <th class="px-4 py-4 text-[10px] font-bold text-gray-500 uppercase tracking-widest">Nama Produk</th>
                                <th class="px-4 py-4 text-[10px] font-bold text-gray-500 uppercase tracking-widest">Nama Varian</th>
                                <th class="px-4 py-4 text-[10px] font-bold text-gray-500 uppercase tracking-widest text-right">HPP</th>
                                <th class="px-4 py-4 text-[10px] font-bold text-gray-500 uppercase tracking-widest text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            <% if (products && products.length > 0) { %>
                                <% products.forEach(product => { %>
                                <tr class="hover:bg-gray-50/80 transition-colors group">
                                    <td class="px-4 py-3">
                                        <div class="text-xs font-bold text-gray-800"><%= product['Product Name'] %></div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <div class="text-xs font-semibold text-gray-700"><%= product['Variant Name'] %></div>
                                    </td>
                                    <td class="px-4 py-3 text-right">
                                        <div class="flex items-center justify-end space-x-1 group/hpp">
                                            <span class="text-[10px] font-bold text-gray-400 mr-1">Rp</span>
                                            <input type="number" 
                                                   value="<%= product['HPP'] || 0 %>" 
                                                   class="hpp-input w-20 bg-transparent border-b border-transparent hover:border-gray-300 focus:border-blue-500 focus:outline-none text-right text-xs font-bold text-gray-900 transition-all p-1"
                                                   data-id="<%= product['ID Product'] %>">
                                            <button onclick="submitHPPUpdate(this)" 
                                                    class="p-1 text-emerald-600 hover:bg-emerald-50 rounded opacity-0 group-hover/hpp:opacity-100 transition-all"
                                                    title="Simpan HPP">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                            </button>
                                        </div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <div class="flex items-center justify-center space-x-2">
                                            <button class="text-gray-400 hover:text-blue-600 transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>
                                            <button class="text-gray-400 hover:text-red-600 transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg></button>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="text-center py-10 text-gray-500 text-sm">Tidak ada data produk yang ditemukan.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
            <%- include('partials/footer') %>
        </div>

        <!-- Modal Konfirmasi Inisialisasi Produk -->
        <% if (locals.previewData && previewData.length > 0) { %>
        <div id="syncModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 px-4">
            <div class="bg-white rounded-xl shadow-xl max-w-2xl w-full max-h-[80vh] flex flex-col">
                <div class="p-6 border-b border-gray-100">
                    <h3 class="text-lg font-bold text-gray-900">Inisialisasi Produk Baru</h3>
                    <p class="text-sm text-gray-500 mt-1">Kami menemukan data produk unik dari riwayat pengiriman. Apakah Anda ingin menambahkannya ke daftar produk?</p>
                </div>
                
                <div class="flex-1 overflow-y-auto p-6">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-gray-50 sticky top-0">
                            <tr>
                                <th class="px-2 py-2 font-bold text-gray-600">Variant Name (Dari Shipment)</th>
                                <th class="px-2 py-2 font-bold text-gray-600">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            <% previewData.forEach(item => { %>
                            <tr>
                                <td class="px-2 py-2 text-gray-700 font-medium"><%= item['Variant Name'] %></td>
                                <td class="px-2 py-2 text-gray-400 italic">Baru</td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <div class="p-6 border-t border-gray-100 flex justify-end space-x-3 bg-gray-50 rounded-b-xl">
                    <button onclick="document.getElementById('syncModal').classList.add('hidden')" class="px-4 py-2 text-sm font-medium text-gray-700 hover:text-gray-900 transition-colors">
                        Batal
                    </button>
                    <form action="/products/confirm-init" method="POST">
                        <input type="hidden" name="productData" value='<%= JSON.stringify(previewData) %>'>
                        <button type="submit" class="px-4 py-2 bg-blue-600 text-white text-sm font-bold rounded-lg hover:bg-blue-700 shadow-sm transition-all">
                            Ya, Simpan Semua
                        </button>
                    </form>
                </div>
            </div>
        </div>
        <% } %>
    </main>

    <script>
        async function submitHPPUpdate(btn) {
            const container = btn.closest('div');
            const input = container.querySelector('.hpp-input');
            const id = input.getAttribute('data-id');
            const hpp = input.value;
            
            // Beri efek visual loading
            btn.disabled = true;
            btn.classList.add('opacity-50');
            input.classList.add('bg-gray-100');
            
            try {
                const response = await fetch('/products/update-hpp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id, hpp })
                });

                if (!response.ok) throw new Error('Gagal update');
                
                // Efek sukses (flash hijau sebentar)
                input.classList.add('text-green-600');
                btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-600"><polyline points="20 6 9 17 4 12"></polyline></svg>';
                
                setTimeout(() => {
                    input.classList.remove('text-green-600');
                }, 2000);
            } catch (err) {
                alert('Gagal memperbarui HPP: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.classList.remove('opacity-50');
                input.classList.remove('bg-gray-100');
            }
        }
    </script>
</body>
</html>