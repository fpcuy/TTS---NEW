<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 flex min-h-screen">
    <%- include('partials/sidebar') %>

    <main class="flex-1 lg:ml-64 xl:ml-72 flex flex-col">
        <header class="bg-white border-b border-gray-200 sticky top-0 z-30 px-6 py-4">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div class="flex items-center space-x-3">
                    <div class="bg-orange-100 p-2 rounded-lg">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="2"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/><path d="M4 4l8 8-8 8"/></svg>
                    </div>
                    <div>
                        <h1 class="text-xl font-bold text-gray-900 leading-tight">Dashboard</h1>
                        <p class="text-xs text-gray-500">Ringkasan cepat dan status laporan</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <button class="inline-flex items-center gap-2 rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-100 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z"/><path d="M14 2v6h6"/><path d="M12 11v6"/><path d="M9 14h6"/></svg>
                        Export Laporan
                    </button>
                    <button class="bg-orange-600 hover:bg-orange-700 text-white h-9 px-4 rounded-md text-xs font-medium shadow-sm transition-colors flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                        Buat Laporan
                    </button>
                </div>
            </div>
        </header>

        <div class="p-6 flex-1">
            <!-- Dashboard Overview -->
            <div class="mb-6">
                <div class="mb-4">
                    <div class="flex items-center px-3 mb-2">
                        <div class="h-px bg-gray-300 flex-1"></div>
                        <h3 class="text-xs font-semibold text-gray-600 uppercase tracking-wider px-2">Dashboard Overview</h3>
                        <div class="h-px bg-gray-300 flex-1"></div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4 mb-6">
                    <!-- Total Shipments -->
                    <div class="bg-blue-50 rounded-xl border border-gray-200 p-4 shadow-sm hover:shadow-md transition-shadow">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-[10px] font-bold text-blue-600 uppercase tracking-wider">Total Shipments</p>
                                <p class="text-2xl font-black text-blue-900 mt-1"><%= stats.totalShipments.toLocaleString('id-ID') %></p>
                            </div>
                            <div class="bg-blue-100 p-3 rounded-lg">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2">
                                    <path d="M20 7h-4V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2Z"/>
                                    <path d="M8 7V5h8v2"/>
                                    <path d="M8 13h8"/>
                                    <path d="M8 17h8"/>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <!-- Delivered Shipments -->
                    <div class="bg-emerald-50 rounded-xl border border-emerald-100 p-4 shadow-sm hover:shadow-md transition-shadow">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-[10px] font-bold text-emerald-600 uppercase tracking-wider">Delivered</p>
                                <p class="text-2xl font-black text-emerald-900 mt-1"><%= (stats.delivered || 0).toLocaleString('id-ID') %></p>
                            </div>
                            <div class="bg-emerald-100 p-3 rounded-lg">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                            </div>
                        </div>
                    </div>

                    <!-- Total Retur -->
                    <div class="bg-red-50 rounded-xl border border-red-100 p-4 shadow-sm hover:shadow-md transition-shadow">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-[10px] font-bold text-red-600 uppercase tracking-wider">Total Retur</p>
                                <p class="text-2xl font-black text-red-900 mt-1"><%= (stats.retur || 0).toLocaleString('id-ID') %></p>
                            </div>
                            <div class="bg-red-100 p-3 rounded-lg">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>
                            </div>
                        </div>
                    </div>

                    <!-- On Proses -->
                    <div class="bg-orange-50 rounded-xl border border-orange-100 p-4 shadow-sm hover:shadow-md transition-shadow">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-[10px] font-bold text-orange-600 uppercase tracking-wider">On Proses</p>
                                <p class="text-2xl font-black text-orange-900 mt-1"><%= (stats.onProcess || 0).toLocaleString('id-ID') %></p>
                            </div>
                            <div class="bg-orange-100 p-3 rounded-lg">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ea580c" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                            </div>
                        </div>
                    </div>

                    <!-- Total COD Amount -->
                    <div class="bg-indigo-50 rounded-xl border border-indigo-100 p-4 shadow-sm hover:shadow-md transition-shadow">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-[10px] font-bold text-indigo-600 uppercase tracking-wider">Total COD</p>
                                <p class="text-xl font-black text-indigo-900 mt-1">Rp <%= (stats.totalCOD || 0).toLocaleString('id-ID') %></p>
                            </div>
                            <div class="bg-indigo-100 p-3 rounded-lg">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#4f46e5" stroke-width="2">
                                    <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                                </svg>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <div class="grid gap-4 xl:grid-cols-3">
                <div class="xl:col-span-2 bg-white rounded-3xl border border-gray-200 p-6 shadow-sm">
                    <div class="flex items-center justify-between mb-4">
                        <div>
                            <h2 class="text-lg font-bold text-gray-900">Ringkasan Transaksi</h2>
                            <p class="text-sm text-gray-500">Ikhtisar perkembangan 30 hari terakhir.</p>
                        </div>
                        <span class="inline-flex items-center rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700">Aktif</span>
                    </div>
                    <div class="space-y-4">
                        <div class="rounded-3xl bg-slate-50 p-4">
                            <p class="text-sm text-gray-500">Persentase pengiriman berhasil</p>
                            <div class="mt-3 h-3 rounded-full bg-gray-200 overflow-hidden">
                                <div class="h-full rounded-full bg-emerald-500" style="width: <%= shipments && shipments.length ? Math.round((shipments.filter(item => item['Tracking Status'] === 'Delivered').length / shipments.length) * 100) : 0 %>%"></div>
                            </div>
                            <p class="text-xs text-gray-500 mt-2"><%= shipments && shipments.length ? Math.round((shipments.filter(item => item['Tracking Status'] === 'Delivered').length / shipments.length) * 100) : 0 %>% dari semua pengiriman</p>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                            <div class="rounded-3xl bg-slate-50 p-4 text-center">
                                <p class="text-xs text-gray-500 uppercase tracking-wider">Batal</p>
                                <p class="text-2xl font-bold text-red-600 mt-2"><%= (shipments || []).filter(item => item['Tracking Status']?.includes('Cancel')).length %></p>
                            </div>
                            <div class="rounded-3xl bg-slate-50 p-4 text-center">
                                <p class="text-xs text-gray-500 uppercase tracking-wider">Rata-rata berat</p>
                                <p class="text-2xl font-bold text-gray-900 mt-2"><%= shipments && shipments.length ? ((shipments.reduce((total, item) => total + (parseFloat(item['Parcel Weight']) || 0), 0) / shipments.length).toFixed(1)) : '0.0' %> kg</p>
                            </div>
                            <div class="rounded-3xl bg-slate-50 p-4 text-center">
                                <p class="text-xs text-gray-500 uppercase tracking-wider">Masuk hari ini</p>
                                <p class="text-2xl font-bold text-gray-900 mt-2"><%= (shipments || []).filter(item => {
                                    if (!item['Create Time']) return false;
                                    const created = new Date(item['Create Time']);
                                    const today = new Date();
                                    return created.toDateString() === today.toDateString();
                                }).length %></p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-3xl border border-gray-200 p-6 shadow-sm">
                    <div class="flex items-center justify-between mb-4">
                        <div>
                            <h2 class="text-lg font-bold text-gray-900">Aktivitas Terbaru</h2>
                            <p class="text-sm text-gray-500">5 entri terakhir</p>
                        </div>
                        <span class="text-xs text-gray-500">Realtime</span>
                    </div>
                    <div class="space-y-3">
                        <% (shipments || []).slice(0, 5).forEach(item => { %>
                        <div class="rounded-3xl bg-slate-50 p-4">
                            <p class="text-sm font-semibold text-gray-900 truncate"><%= item['Recipient Name'] || 'Nama tidak tersedia' %></p>
                            <p class="text-xs text-gray-500"><%= item['Tracking No'] || 'No tracking belum diisi' %> • <%= item['Tracking Status'] || 'Status tidak diketahui' %></p>
                        </div>
                        <% }) %>
                        <% if (!shipments || shipments.length === 0) { %>
                        <p class="text-sm text-gray-500">Belum ada data transaksi.</p>
                        <% } %>
                    </div>
                </div>
            </div>

            <%- include('partials/footer') %>
        </div>
    </main>
</body>
</html>
