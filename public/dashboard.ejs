<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 flex min-h-screen">
    <%- include('partials/sidebar') %>

    <main class="flex-1 lg:ml-64 xl:ml-72 flex flex-col">
        <header class="bg-white border-b border-gray-200 sticky top-0 z-30 px-6 py-4">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div class="flex items-center space-x-3">
                    <div class="bg-orange-100 p-2 rounded-lg">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="2"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/><path d="M4 4l8 8-8 8"/></svg>
                    </div>
                    <div>
                        <h1 class="text-xl font-bold text-gray-900 leading-tight">Dashboard</h1>
                        <p class="text-xs text-gray-500">Ringkasan cepat dan status laporan</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <button class="inline-flex items-center gap-2 rounded-md border border-gray-300 bg-white px-3 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-100 transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z"/><path d="M14 2v6h6"/><path d="M12 11v6"/><path d="M9 14h6"/></svg>
                        Export Laporan
                    </button>
                    <button class="bg-orange-600 hover:bg-orange-700 text-white h-9 px-4 rounded-md text-xs font-medium shadow-sm transition-colors flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                        Buat Laporan
                    </button>
                </div>
            </div>
        </header>

        <div class="p-6 flex-1">
            <!-- Dashboard Overview -->
            <div class="mb-6">
                <div class="mb-4">
                    <div class="flex items-center px-3 mb-2">
                        <div class="h-px bg-gray-300 flex-1"></div>
                        <h3 class="text-xs font-semibold text-gray-600 uppercase tracking-wider px-2">Dashboard Overview</h3>
                        <div class="h-px bg-gray-300 flex-1"></div>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4 mb-6">
                    <!-- Total Shipments -->
                    <div class="bg-blue-50 rounded-xl border border-gray-200 p-4 shadow-sm hover:shadow-md transition-shadow">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-[10px] font-bold text-blue-600 uppercase tracking-wider">Total Resi</p>
                                <p class="text-2xl font-bold text-blue-600 mt-1"><%= (stats['Total Resi'] || 0).toLocaleString('id-ID') %></p>
                            </div>
                            <div class="bg-blue-100 p-3 rounded-lg">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2">
                                    <path d="M20 7h-4V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2Z"/>
                                    <path d="M8 7V5h8v2"/>
                                    <path d="M8 13h8"/>
                                    <path d="M8 17h8"/>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <!-- Total Delivered -->
                    <div class="bg-green-50 rounded-xl border border-gray-200 p-4 shadow-sm hover:shadow-md transition-shadow">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-[10px] font-bold text-green-600 uppercase tracking-wider">Total Delivered</p>
                                <p class="text-2xl font-bold text-green-600 mt-1"><%= (stats['Total Delivered'] || 0).toLocaleString('id-ID') %></p>
                            </div>
                            <div class="bg-green-100 p-3 rounded-lg">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2">
                                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                            </div>
                        </div>
                    </div>

                    <!-- Total On Proses -->
                    <div class="bg-yellow-50 rounded-xl border border-gray-200 p-4 shadow-sm hover:shadow-md transition-shadow">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-[10px] font-bold text-yellow-600 uppercase tracking-wider">Total On Proses</p>
                                <p class="text-2xl font-bold text-yellow-600 mt-1"><%= (stats['Total On Proses'] || 0).toLocaleString('id-ID') %></p>
                            </div>
                            <div class="bg-yellow-100 p-3 rounded-lg">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ffc107" stroke-width="2"> 
                                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                                </svg>
                            </div>
                            </div>
                    </div>

                    <!-- Total Retur -->
                    <div class="bg-red-50 rounded-xl border border-gray-200 p-4 shadow-sm hover:shadow-md transition-shadow">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-[10px] font-bold text-red-600 uppercase tracking-wider">Total Retur</p>
                                <p class="text-2xl font-bold text-red-600 mt-1"><%= (stats['Total Retur'] || 0).toLocaleString('id-ID') %></p>
                                </div>
                            <div class="bg-red-100 p-3 rounded-lg">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#e53e3e" stroke-width="2">
                                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <!-- Total Uang Masuk -->
                    <div class="bg-blue-50 rounded-xl border border-gray-200 p-4 shadow-sm hover:shadow-md transition-shadow">
                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-[10px] font-bold text-blue-600 uppercase tracking-wider">Total Uang Masuk</p>
                                <p class="text-2xl font-bold text-blue-600 mt-1">Rp.<%= (stats['Uang Masuk'] || 0).toLocaleString('id-ID') %></p>
                            </div>
                            <div class="bg-blue-100 p-3 rounded-lg">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2">
                                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                                </svg>
                            </div>
                        </div>
                    </div>

                </div>
            </div>


            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- CS Leaderboard -->
                <div class="bg-white rounded-3xl border border-gray-200 shadow-sm overflow-hidden">
                    <div class="p-6 border-b border-gray-100 flex items-center justify-between bg-slate-50/50">
                        <div>
                            <h2 class="text-lg font-bold text-gray-900">Leaderboard CS</h2>
                            <p class="text-xs text-gray-500">Performa Customer Service berdasarkan Uang Masuk</p>
                        </div>
                        <div class="bg-blue-100 p-2 rounded-lg">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        </div>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead class="bg-gray-50 text-[10px] font-bold text-gray-500 uppercase tracking-wider">
                                <tr>
                                    <th class="px-6 py-3">Nama Agen</th>
                                    <th class="px-6 py-3 text-center">Resi</th>
                                    <th class="px-6 py-3 text-center">Delivered</th>
                                    <th class="px-6 py-3 text-center">Rate</th>
                                    <th class="px-6 py-3 text-right">Uang Masuk</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                <% csLeaderboard.forEach((cs, index) => { %>
                                    <!-- Row Utama (Summary) -->
                                    <tr class="hover:bg-blue-50/50 transition-colors cursor-pointer group" onclick="toggleDropdown('cs-details-<%= index %>')">
                                        <td class="px-6 py-4 flex items-center gap-2">
                                            <svg id="icon-<%= index %>" class="w-4 h-4 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                            <div class="text-sm font-bold text-gray-900"><%= cs.agentName %></div>
                                        </td>
                                        <td class="px-6 py-4 text-center">
                                            <span class="text-sm text-gray-600"><%= cs.totalResi.toLocaleString('id-ID') %></span>
                                        </td>
                                        <td class="px-6 py-4 text-center">
                                            <span class="text-sm font-semibold text-emerald-600"><%= cs.totalDelivered.toLocaleString('id-ID') %></span>
                                        </td>
                                        <td class="px-6 py-4 text-right">
                                        <% const csRate = cs.totalResi > 0 ? ((cs.totalDelivered / cs.totalResi) * 100).toFixed(1) : 0 %>
                                        <span class="text-sm font-bold text-gray-700"><%= csRate %>%</span>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                            <span class="text-sm font-bold text-blue-600">Rp<%= cs.totalUangMasuk.toLocaleString('id-ID') %></span>
                                        </td>
                                    </tr>
                                    <!-- Row Dropdown (Produk) -->
                                    <tr id="cs-details-<%= index %>" class="hidden bg-gray-50/50">
                                        <td colspan="5" class="px-4 py-3">
                                            <div class="rounded-xl border border-gray-200 bg-white overflow-hidden shadow-sm mx-4">
                                                <table class="w-full text-sm">
                                                    <thead class="bg-slate-50 text-[10px] text-gray-400 font-bold uppercase tracking-widest border-b border-gray-100">
                                                        <tr>
                                                            <th class="px-4 py-2 text-left">Produk</th>
                                                            <th class="px-4 py-2 text-center">Resi</th>
                                                            <th class="px-4 py-2 text-center">Deliv</th>
                                                            <th class="px-4 py-2 text-center">Retur</th>
                                                            <th class="px-4 py-2 text-right">Uang Masuk</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody class="divide-y divide-gray-100">
                                                        <% cs.products.forEach(prod => { %>
                                                            <tr class="hover:bg-gray-50 transition-colors">
                                                                <td class="px-4 py-2.5 font-medium text-gray-700"><%= prod['Product Name'] %></td>
                                                                <td class="px-4 py-2.5 text-center text-gray-500"><%= prod['Total Resi'] %></td>
                                                                <td class="px-4 py-2.5 text-center text-emerald-600 font-bold"><%= prod['Total Delivered'] %></td>
                                                                <td class="px-4 py-2.5 text-center text-red-500"><%= prod['Total Retur'] %></td>
                                                                <td class="px-4 py-2.5 text-right font-bold text-gray-900">Rp<%= parseFloat(prod['Uang Masuk']).toLocaleString('id-ID') %></td>
                                                            </tr>
                                                        <% }) %>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
                
                <div class="flex flex-col gap-6">
                    <!-- Top 5 CS Performance -->
                    <div class="bg-white rounded-3xl border border-gray-200 shadow-sm overflow-hidden">
                        <div class="p-6 border-b border-gray-100 flex items-center justify-between bg-indigo-50/50">
                            <div>
                                <h2 class="text-lg font-bold text-gray-900">Top 5 Performa CS</h2>
                                <p class="text-xs text-gray-500">Berdasarkan Uang Masuk & Delivered</p>
                            </div>
                            <div class="bg-indigo-100 p-2 rounded-lg">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2"><path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"/><circle cx="12" cy="8" r="6"/></svg>
                            </div>
                        </div>
                        <div class="p-4 space-y-3">
                            <% csLeaderboard.slice(0, 5).forEach((cs, i) => { %>
                                <div class="flex items-center justify-between p-3 rounded-2xl bg-gray-50 hover:bg-indigo-50 transition-colors">
                                    <div class="flex items-center gap-3">
                                        <span class="flex items-center justify-center w-6 h-6 rounded-full bg-indigo-600 text-white text-[10px] font-bold"><%= i + 1 %></span>
                                        <div>
                                            <p class="text-sm font-bold text-gray-900"><%= cs.agentName %></p>
                                            <p class="text-[10px] text-gray-500">Delivered: <span class="font-bold text-emerald-600"><%= cs.totalDelivered.toLocaleString('id-ID') %></span></p>
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-sm font-bold text-indigo-600">Rp<%= cs.totalUangMasuk.toLocaleString('id-ID') %></p>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>

                    <!-- Product Leaderboard -->
                    <div class="bg-white rounded-3xl border border-gray-200 shadow-sm overflow-hidden">
                        <div class="p-6 border-b border-gray-100 flex items-center justify-between bg-slate-50/50">
                            <div>
                                <h2 class="text-lg font-bold text-gray-900">Leaderboard Produk</h2>
                                <p class="text-xs text-gray-500">Produk paling banyak terjual</p>
                            </div>
                            <div class="bg-orange-100 p-2 rounded-lg">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f97316" stroke-width="2"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
                            </div>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left">
                                <thead class="bg-gray-50 text-[10px] font-bold text-gray-500 uppercase tracking-wider">
                                    <tr>
                                        <th class="px-6 py-3">Produk</th>
                                    <th class="px-6 py-3 text-center">Resi</th>
                                    <th class="px-6 py-3 text-center">Deliv</th>
                                    <th class="px-6 py-3 text-center">Rate</th>
                                        <th class="px-6 py-3 text-right">Uang Masuk</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-100">
                                    <% productLeaderboard.forEach(prod => { %>
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        <td class="px-6 py-4">
                                            <div class="text-sm font-bold text-gray-900 truncate max-w-[150px]"><%= prod['Product Name'] || 'Produk' %></div>
                                        </td>
                                        <td class="px-6 py-4 text-center">
                                        <span class="text-sm text-gray-600"><%= prod['Total Resi'] || 0 %></span>
                                        </td>
                                        <td class="px-6 py-4 text-center">
                                        <span class="text-sm font-semibold text-emerald-600"><%= prod['Total Delivered'] || 0 %></span>
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        <% const prodRate = (prod['Total Resi'] || 0) > 0 ? ((prod['Total Delivered'] / prod['Total Resi']) * 100).toFixed(1) : 0 %>
                                        <span class="text-sm font-bold text-gray-700"><%= prodRate %>%</span>
                                        </td>
                                        <td class="px-6 py-4 text-right">
                                            <span class="text-sm font-bold text-blue-600">Rp<%= (prod['Uang Masuk'] || 0).toLocaleString('id-ID') %></span>
                                        </td>
                                    </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <%- include('partials/footer') %>
        </div>
    </main>

    <script>
        function toggleDropdown(id) {
            const detailsRow = document.getElementById(id);
            const index = id.split('-').pop();
            const icon = document.getElementById('icon-' + index);
            
            if (detailsRow.classList.contains('hidden')) {
                detailsRow.classList.remove('hidden');
                icon.style.transform = 'rotate(180deg)';
            } else {
                detailsRow.classList.add('hidden');
                icon.style.transform = 'rotate(0deg)';
            }
        }
    </script>
</body>
</html>
