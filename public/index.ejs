<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shipments</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 flex min-h-screen">
    <%- include('partials/sidebar') %>

    <!-- Main Content -->
    <main class="flex-1 lg:ml-64 xl:ml-72 flex flex-col">
        <%- include('partials/header', { pageTitle: pageTitle }) %>

        <!-- Main Table Container -->
        <div class="p-6 flex-1">
            <div class="bg-white shadow-sm border border-gray-200 rounded-xl overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead class="bg-gray-50 border-b-2 border-gray-100">
                            <tr>
                                <th class="px-4 py-4 text-[10px] font-bold text-gray-500 uppercase tracking-widest">Tracking No</th>
                                <th class="px-4 py-4 text-[10px] font-bold text-gray-500 uppercase tracking-widest">Penerima</th>
                                <th class="px-4 py-4 text-[10px] font-bold text-gray-500 uppercase tracking-widest">Berat</th>
                                <th class="px-4 py-4 text-[10px] font-bold text-gray-500 uppercase tracking-widest text-right">Ongkir</th>
                                <th class="px-4 py-4 text-[10px] font-bold text-gray-500 uppercase tracking-widest text-center">Status</th>
                                <th class="px-4 py-4 text-[10px] font-bold text-gray-500 uppercase tracking-widest text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            <% shipments.forEach(item => { %>
                            <tr class="hover:bg-gray-50/80 transition-colors group">
                                <td class="px-4 py-3">
                                    <a href="<%= item['Tracking No link'] %>" target="_blank" class="text-xs font-bold text-blue-600 leading-none mb-1 hover:underline"><%= item['Tracking No'] %> </a><i class="fas fa-external-link-alt"></i>
                                </td>
                                <td class="px-4 py-3">
                                    <div class="text-xs font-semibold text-gray-800"><%= item['Recipient Name'] %></div>
                                    <div class="text-[10px] text-gray-500 truncate max-w-[150px]"><%= item['Recipient City'] %></div>
                                </td>
                                <td class="px-4 py-3">
                                    <div class="text-xs text-gray-700 font-mono"><%= item['Parcel Weight'] %> kg</div>
                                </td>
                                <td class="px-4 py-3 text-right">
                                    <div class="text-xs font-bold text-gray-900 italic">Rp<%= item['Estimated Shipping Fee']?.toLocaleString('id-ID') %></div>
                                </td>
                                <td class="px-4 py-3 text-center">
                                    <% 
                                        let statusClass = 'bg-yellow-100 text-yellow-700 border-yellow-200';
                                        if(item['Tracking Status'] === 'Delivered') statusClass = 'bg-emerald-100 text-emerald-700 border-emerald-200';
                                        if(item['Tracking Status']?.includes('Cancel')) statusClass = 'bg-red-100 text-red-700 border-red-200';
                                    %>
                                    <span class="inline-flex px-2 py-1 text-[10px] font-bold rounded-md border <%= statusClass %>">
                                        <%= item['Tracking Status'] %>
                                    </span>
                                </td>
                                <td class="px-4 py-3">
                                    <div class="flex items-center justify-center space-x-2">
                                        <button class="text-gray-400 hover:text-orange-600 transition-colors">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                        </button>
                                        <button class="text-gray-400 hover:text-red-600 transition-colors">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <% if (shipments.length === 0) { %>
                    <div class="text-center py-20">
                        <div class="bg-gray-100 w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
                        </div>
                        <h3 class="text-sm font-medium text-gray-900">Belum ada data</h3>
                        <p class="text-xs text-gray-500 mt-1">Silakan unggah file Excel untuk memulai.</p>
                    </div>
                <% } %>
            </div>
            
            <%- include('partials/footer') %>
        </div>
    </main>

    <!-- Upload Modal -->
    <div id="uploadModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex items-center justify-center">
        <div class="bg-white rounded-lg shadow-xl max-w-lg w-full mx-4 p-6">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <div class="flex items-center gap-2">
                        <div class="bg-blue-100 p-2 rounded-lg">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="none" viewBox="0 0 24 24" stroke="#2563eb" stroke-width="2"><rect width="20" height="20" x="2" y="2" rx="4"/><path d="M8 10h8M8 14h5"/></svg>
                        </div>
                        <div>
                            <h3 class="text-base font-bold text-gray-900">File Pesanan</h3>
                            <p class="text-xs text-gray-500">Unggah file ekspor pesanan Anda</p>
                        </div>
                    </div>
                </div>
                <button onclick="closeUploadModal()" class="text-gray-400 hover:text-gray-600">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18"/><path d="M6 6l12 12"/></svg>
                </button>
            </div>
            <form id="excelUploadForm" action="http://localhost:3211/upload" method="POST" enctype="multipart/form-data">
                <div id="dropzone" class="flex flex-col items-center justify-center border-2 border-dashed border-gray-300 rounded-xl bg-gray-50 py-8 px-4 mb-6 cursor-pointer transition hover:border-orange-400 hover:bg-orange-50 text-center relative" onclick="document.getElementById('excelFileInput').click()" ondragover="event.preventDefault(); this.classList.add('border-orange-400','bg-orange-50')" ondragleave="this.classList.remove('border-orange-400','bg-orange-50')" ondrop="handleDrop(event)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="none" viewBox="0 0 24 24" stroke="#9ca3af" stroke-width="1.5" class="mx-auto mb-2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 16V4m0 0L8 8m4-4 4 4"/><rect width="20" height="12" x="2" y="12" rx="2"/></svg>
                    <span class="block font-semibold text-gray-700 mb-1">Klik untuk mengunggah <span class="font-normal text-gray-400">atau seret dan lepas</span></span>
                    <span class="text-xs text-gray-400">File Excel (.xlsx, .xls)</span>
                    <input id="excelFileInput" type="file" name="excel_file" accept=".xlsx, .xls" required class="hidden" onchange="updateFileName()">
                    <span id="fileNameDisplay" class="block mt-2 text-xs text-green-600 font-medium"></span>
                </div>
                <div class="flex justify-end gap-2 mt-2">
                    <button type="button" onclick="resetUploadForm()" class="flex items-center gap-1 px-4 py-2 text-sm font-medium text-red-600 border border-red-200 bg-white hover:bg-red-50 rounded-md">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/></svg>
                        Hapus Semua
                    </button>
                    <button type="submit" class="flex items-center gap-1 px-4 py-2 text-sm font-medium text-white bg-orange-400 hover:bg-orange-500 rounded-md">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 16v-8m0 0-4 4m4-4 4 4"/><rect width="20" height="12" x="2" y="12" rx="2"/></svg>
                        Proses File
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openUploadModal() {
            document.getElementById('uploadModal').classList.remove('hidden');
        }
        function closeUploadModal() {
            document.getElementById('uploadModal').classList.add('hidden');
        }
        function updateFileName() {
            const input = document.getElementById('excelFileInput');
            const display = document.getElementById('fileNameDisplay');
            if (input.files.length > 0) {
                display.textContent = input.files[0].name;
            } else {
                display.textContent = '';
            }
        }
        function resetUploadForm() {
            document.getElementById('excelFileInput').value = '';
            document.getElementById('fileNameDisplay').textContent = '';
        }
        function handleDrop(event) {
            event.preventDefault();
            const input = document.getElementById('excelFileInput');
            if (event.dataTransfer.files.length > 0) {
                input.files = event.dataTransfer.files;
                updateFileName();
            }
            document.getElementById('dropzone').classList.remove('border-orange-400','bg-orange-50');
        }
    </script>
</body>
</html>