<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Slip Gaji - <%= cs['Agent Name'] %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @media print {
            .no-print { display: none; }
            body { background: white; }
            .print-area { border: none; shadow: none; }
        }
    </style>
</head>
<body class="bg-gray-100 p-8">
    <div class="no-print mb-6 flex justify-center gap-4">
        <button onclick="window.print()" class="bg-blue-600 text-white px-6 py-2 rounded-lg font-bold shadow-md hover:bg-blue-700">Cetak Slip</button>
        <a href="/performance-cs" class="bg-gray-200 text-gray-700 px-6 py-2 rounded-lg font-bold">Kembali</a>
    </div>

    <div class="print-area max-w-2xl mx-auto bg-white border border-gray-200 p-10 shadow-sm rounded-lg">
        <div class="text-center border-b-2 border-gray-900 pb-6 mb-8">
            <h1 class="text-2xl font-black uppercase tracking-tighter">Slip Gaji Customer Service</h1>
            <p class="text-sm text-gray-500 mt-1">Periode: <%= startDate || 'N/A' %> s/d <%= endDate || 'N/A' %></p>
        </div>

        <div class="grid grid-cols-2 gap-8 mb-10">
            <div>
                <p class="text-[10px] uppercase font-bold text-gray-400">Nama Karyawan</p>
                <p class="text-lg font-bold text-gray-900"><%= cs['Agent Name'] %></p>
            </div>
            <div class="text-right">
                <p class="text-[10px] uppercase font-bold text-gray-400">Jabatan</p>
                <p class="text-lg font-bold text-gray-900">Customer Service</p>
            </div>
        </div>

        <div class="space-y-4 mb-10">
            <div class="flex justify-between border-b border-gray-100 pb-2">
                <span class="text-gray-600">Total Paket Berhasil (Delivered)</span>
                <span class="font-mono font-bold"><%= cs['Total Delivered'] %> Paket</span>
            </div>
            <div class="flex justify-between border-b border-gray-100 pb-2">
                <span class="text-gray-600">Komisi per Paket</span>
                <span class="font-mono font-bold">Rp 5.000</span>
            </div>
        </div>

        <div class="bg-gray-900 text-white p-6 rounded-xl flex justify-between items-center mb-10">
            <div>
                <p class="text-[10px] uppercase font-bold text-gray-400">Total Gaji / Insentif</p>
                <h2 class="text-3xl font-black">Rp<%= (cs['Total Delivered'] * 5000).toLocaleString('id-ID') %></h2>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="opacity-20"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
        </div>

        <div class="grid grid-cols-2 gap-20 pt-10">
            <div class="text-center">
                <p class="text-xs text-gray-400 mb-16">Penerima,</p>
                <div class="border-b border-gray-900 w-full mx-auto"></div>
                <p class="text-sm font-bold mt-2"><%= cs['Agent Name'] %></p>
            </div>
            <div class="text-center">
                <p class="text-xs text-gray-400 mb-16">Manager Operasional,</p>
                <div class="border-b border-gray-900 w-full mx-auto"></div>
                <p class="text-sm font-bold mt-2">Admin TTS</p>
            </div>
        </div>
    </div>
</body>
</html>