<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customer Service Management</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 flex min-h-screen">
    <%- include('partials/sidebar') %>

    <!-- Main Content -->
    <main class="flex-1 lg:ml-64 xl:ml-72 flex flex-col">
        <!-- Header -->
        <header class="bg-white border-b border-gray-200 sticky top-0 z-30 px-6 py-4">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div class="flex items-center space-x-3">
                    <div class="bg-blue-50 p-2 rounded-lg">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-xl font-bold text-gray-900 leading-tight">Customer Service</h1>
                        <p class="text-xs text-gray-500">Manajemen data customer service agents</p>
                    </div>
                </div>
                <button type="button" id="openFormBtn" class="bg-blue-600 hover:bg-blue-700 text-white h-9 px-4 rounded-md text-sm font-medium shadow-sm transition-colors flex items-center gap-2 whitespace-nowrap">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                    Tambah Agent
                </button>
            </div>
        </header>

        <!-- Alert Messages -->
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="m-4 p-4 bg-red-50 border border-red-200 rounded-lg flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" class="flex-shrink-0 mt-0.5">
                    <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                <div>
                    <h3 class="font-semibold text-red-800"><%= error %></h3>
                </div>
            </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="m-4 p-4 bg-green-50 border border-green-200 rounded-lg flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" class="flex-shrink-0 mt-0.5">
                    <polyline points="20 6 9 17 4 12"/></svg>
                <div>
                    <h3 class="font-semibold text-green-800"><%= success %></h3>
                </div>
            </div>
        <% } %>

        <!-- Main Content Area -->
        <div class="flex-1 p-6">
            <!-- Add/Edit Form -->
            <div id="formContainer" class="<%= editingId ? '' : 'hidden' %> mb-6 bg-white rounded-lg border border-gray-200 p-6">
                <h2 class="text-lg font-bold mb-4"><%= editingId ? 'Edit Customer Service' : 'Tambah Customer Service Baru' %></h2>
                <form method="POST" action="<%= editingId ? '/customer-service/update' : '/customer-service/create' %>" class="space-y-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">ID Customer Service <span class="text-red-600">*</span></label>
                            <input type="text" name="id" value="<%= editingData ? editingData['ID Customer Service'] : '' %>" <%= editingId ? 'readonly' : '' %> placeholder="CSA001" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 <%= editingId ? 'bg-gray-100' : '' %>" required>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Nama Asli <span class="text-red-600">*</span></label>
                            <input type="text" name="realName" value="<%= editingData?.['Real Name'] || '' %>" placeholder="Budi Santoso" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" required>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Nama Agent <span class="text-red-600">*</span></label>
                            <input type="text" name="agentName" value="<%= editingData?.['Agent Name'] || '' %>" placeholder="Agent Budi" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" required>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Nomor Telepon <span class="text-red-600">*</span></label>
                            <input type="tel" name="phoneNumber" value="<%= editingData?.['Phone Number'] || '' %>" placeholder="082123456789" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" required>
                        </div>
                    </div>

                    <div class="flex gap-3 pt-4">
                        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-md font-medium transition-colors">
                            <%= editingId ? 'Simpan Perubahan' : 'Tambah Agent' %>
                        </button>
                        <button type="button" id="cancelFormBtn" class="bg-gray-300 hover:bg-gray-400 text-gray-800 px-6 py-2 rounded-md font-medium transition-colors">
                            Batal
                        </button>
                    </div>
                </form>
            </div>

            <!-- Customer Services Table -->
            <div class="bg-white rounded-lg border border-gray-200 overflow-hidden">
                <div class="overflow-x-auto">
                    <% if (customerServices && customerServices.length > 0) { %>
                        <table class="w-full">
                            <thead class="bg-gray-50 border-b border-gray-200">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">ID</th>
                                    <th class="px-6 py-3 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">Nama Asli</th>
                                    <th class="px-6 py-3 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">Nama Agent</th>
                                    <th class="px-6 py-3 text-left text-xs font-bold text-gray-600 uppercase tracking-wider">Nomor Telepon</th>
                                    <th class="px-6 py-3 text-center text-xs font-bold text-gray-600 uppercase tracking-wider">Aksi</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200">
                                <% customerServices.forEach((cs, index) => { %>
                                    <tr class="hover:bg-gray-50 transition-colors">
                                        <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= cs['ID Customer Service'] %></td>
                                        <td class="px-6 py-4 text-sm text-gray-700"><%= cs['Real Name'] %></td>
                                        <td class="px-6 py-4 text-sm text-gray-700"><%= cs['Agent Name'] %></td>
                                        <td class="px-6 py-4 text-sm text-gray-700"><%= cs['Phone Number'] %></td>
                                        <td class="px-6 py-4 flex items-center justify-center gap-2">
                                            <a href="/customer-service/edit/<%= cs['ID Customer Service'] %>" class="inline-flex items-center gap-1 bg-blue-50 hover:bg-blue-100 text-blue-600 px-3 py-2 rounded-md text-xs font-medium transition-colors">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                </svg>
                                                Edit
                                            </a>
                                            <form method="POST" action="/customer-service/delete" class="inline" onsubmit="return confirm('Yakin ingin menghapus?');">
                                                <input type="hidden" name="id" value="<%= cs['ID Customer Service'] %>">
                                                <button type="submit" class="inline-flex items-center gap-1 bg-red-50 hover:bg-red-100 text-red-600 px-3 py-2 rounded-md text-xs font-medium transition-colors">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/>
                                                    </svg>
                                                    Hapus
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <div class="text-center py-12">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2" class="mx-auto mb-3">
                                <circle cx="12" cy="12" r="1"/><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                            </svg>
                            <p class="text-gray-500 font-medium">Tidak ada data customer service</p>
                            <p class="text-gray-400 text-sm">Klik tombol "Tambah Agent" untuk menambahkan data baru</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </main>

    <script>
        const formContainer = document.getElementById('formContainer');
        const openFormBtn = document.getElementById('openFormBtn');
        const cancelFormBtn = document.getElementById('cancelFormBtn');

        openFormBtn.addEventListener('click', () => {
            formContainer.classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        cancelFormBtn.addEventListener('click', () => {
            formContainer.classList.add('hidden');
            document.querySelector('form').reset();
            window.location.href = '/customer-service';
        });
    </script>
</body>
</html>
